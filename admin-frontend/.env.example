# Optional override. Localhost defaults to the local backend; hosted builds
# default to the Render backend when this variable is omitted.
VITE_API_BASE_URL=https://animua-backend.onrender.com/api

# Firebase Console > Project settings > Cloud Messaging > Web Push certificates.
VITE_FIREBASE_VAPID_KEY=replace-with-your-public-web-push-certificate-key
