# Copy this file to backend/.env.test and replace every placeholder locally.
# Never commit backend/.env.test.
APP_ENVIRONMENT=functionality-testing
PORT=5000
APP_BASE_URL=http://127.0.0.1:5173

JWT_SECRET=<ft-only-long-random-jwt-secret>

FIREBASE_PROJECT_ID=<ft-project-id>
# Optional explicit cross-check. If omitted, the project is derived from the
# service-account email domain and still validated by the baseline guard.
FIREBASE_SERVICE_ACCOUNT_PROJECT_ID=<ft-project-id>
FIREBASE_CLIENT_EMAIL=<ft-service-account-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<ft-private-key>\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=<ft-storage-bucket>
FUNCTIONALITY_TEST_PROJECT_ID=<ft-project-id>

# Leave FIRESTORE_EMULATOR_HOST, FIREBASE_AUTH_EMULATOR_HOST,
# FIREBASE_STORAGE_EMULATOR_HOST, and GCLOUD_PROJECT unset for hosted FT.

RECAPTCHA_SECRET_KEY=<ft-recaptcha-secret-key>

# Dedicated testing mailbox used for delivered OTP messages.
EMAIL_USER=<ft-otp-mailbox-address>
EMAIL_PASS=<ft-otp-mailbox-app-password>

# Dedicated baseline credentials. Use test-only mailboxes and strong secrets.
# Passwords are never printed and are bcrypt-hashed in Firestore by the seed tool.
FT_PUBLIC_PASSWORD=<ft-public-account-password>
FT_MANAGEMENT_PASSWORD=<ft-management-account-password>
FT_REGISTRATION_ACCOUNT_EMAIL=<ft-registration-test-email>

FT_CLIENT_ACTIVE_EMAIL=<ft-client-active-email>
FT_CLIENT_UNVERIFIED_EMAIL=<ft-client-unverified-email>
FT_CLIENT_INACTIVE_EMAIL=<ft-client-inactive-email>
FT_CLIENT_PROFILE_MUTABLE_EMAIL=<ft-client-profile-mutable-email>
FT_CLIENT_NOTIFICATIONS_EMAIL=<ft-client-notifications-email>
FT_CLIENT_QUIZ_NEW_EMAIL=<ft-client-quiz-new-email>
FT_CLIENT_QUIZ_COOLDOWN_EMAIL=<ft-client-quiz-cooldown-email>
FT_CLIENT_QUIZ_ELIGIBLE_EMAIL=<ft-client-quiz-eligible-email>
FT_ADMIN_ACTIVE_EMAIL=<ft-admin-active-email>
FT_STAFF_ACTIVE_EMAIL=<ft-staff-active-email>
FT_VET_ACTIVE_EMAIL=<ft-vet-active-email>
FT_MANAGEMENT_INACTIVE_EMAIL=<ft-management-inactive-email>
FT_MANAGEMENT_PROFILE_MUTABLE_EMAIL=<ft-management-profile-mutable-email>
