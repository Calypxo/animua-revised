# Required by authentication and protected routes.
APP_ENVIRONMENT=normal-development
JWT_SECRET=replace-with-a-long-random-secret

# Required when the Firebase service-account JSON file is not deployed.
FIREBASE_PROJECT_ID=animua-angelescity
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=animua-angelescity.firebasestorage.app

# Required for registration, password-change, and forgot-password OTP emails.
EMAIL_USER=your-gmail-address@example.com
EMAIL_PASS=your-16-character-gmail-app-password
# EMAIL_APP_PASSWORD and SMTP_PASS are also accepted password variable names.

# Required by public registration CAPTCHA validation.
RECAPTCHA_SECRET_KEY=replace-with-your-recaptcha-secret

# Optional public URL used for images embedded in OTP emails.
APP_BASE_URL=https://animua-angelescity.web.app
